# An angle bracket: two plates at right angles, a web between them, and a hole
# in each plate. '${...}' is worked out over the part's parameters.
difference:
  - union:
      - cuboid: ["${width}", 30, 4]
      - cuboid: ["${width}", 4, "${height}"]
      # The web, a triangle in the YZ plane, extruded across the middle.
      - extrude:
          height: 4
          profile:
            polygon: [[0, 0], [20, 0], [0, "${height - 4}"]]
        rotate: [90, 0, 90]
        translate: ["${width / 2 - 2}", 4, 4]
  - cylinder: {r: "${hole / 2}", h: 10, segments: 32}
    translate: ["${width / 4}", 18, -3]
  - cylinder: {r: "${hole / 2}", h: 10, segments: 32}
    translate: ["${width * 3 / 4}", 18, -3]
  - cylinder: {r: "${hole / 2}", h: 10, segments: 32}
    rotate: [-90, 0, 0]
    translate: ["${width / 2}", -3, "${height * 2 / 3}"]

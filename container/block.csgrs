# A cube with a hole through every face, read from this file and built in the
# plugin's image.
difference:
  - cube: "${size}"
  - cylinder: {r: "${size / 4}", h: "${size + 2}", segments: 24}
    translate: ["${size / 2}", "${size / 2}", -1]
  - cylinder: {r: "${size / 4}", h: "${size + 2}", segments: 24}
    rotate: [90, 0, 0]
    translate: ["${size / 2}", "${size + 1}", "${size / 2}"]
  - cylinder: {r: "${size / 4}", h: "${size + 2}", segments: 24}
    rotate: [0, 90, 0]
    translate: [-1, "${size / 2}", "${size / 2}"]
